# VHS: talkd init — identity setup
Output vhs/init.gif

Set Shell "bash"
Set FontSize 32
Set Width 1200
Set Height 600
Set Padding 30
Set Theme "Molokai"
Set TypingSpeed 60ms
Set CursorBlink false

Hide
  Type 'export PS1="$ "' Enter
  Sleep 0.3
  Type "clear" Enter
  Sleep 0.3
Show

Sleep 0.5s

Type "talkd init"
Sleep 300ms
Enter
Sleep 3s

Type "talkd id"
Sleep 300ms
Enter
Sleep 3s

Sleep 1s
